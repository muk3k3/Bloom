# ------------------------------------------------------------------
# Bloom — configuración del servidor
#
# Copia este archivo a .env:  cp .env.example .env
#
# .env NUNCA se sube al repositorio.
# ------------------------------------------------------------------

# --- Base de datos -------------------------------------------------
# Desarrollo: el Postgres de docker-compose.yml, puerto 5433
DATABASE_URL="postgresql://bloom:bloom@localhost:5433/bloom?schema=public"

# Solo para migraciones de Prisma, sin pooler.
# En producción, esta apunta a la conexión directa de Supabase.
DIRECT_URL="postgresql://bloom:bloom@localhost:5433/bloom?schema=public"

# --- Servidor ------------------------------------------------------
PORT=3001
NODE_ENV=development

# Origen permitido para CORS. En desarrollo es el cliente Next.js.
APP_URL="http://localhost:3000"

# --- Acceso -------------------------------------------------------
# Único correo con permiso para entrar al panel.
# Cualquier otro correo recibe 403 aunque tenga la contraseña correcta.
OWNER_EMAIL="dueno@bloom.local"

# Firma de la cookie de sesión.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET="cambia-esto-por-una-cadena-aleatoria-de-32-caracteres"

# --- Supabase (solo en producción) --------------------------------
# La service role da acceso TOTAL al proyecto. Nunca viaja al navegador.
# SUPABASE_URL="https://tuproyecto.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="..."

# --- Almacenamiento de fotos ---------------------------------------
# local = disco en server/.uploads (desarrollo)
# supabase = Supabase Storage (producción)
ALMACEN="local"