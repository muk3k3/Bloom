{
  "name": "bloom",
  "version": "0.1.0",
  "private": true,
  "description": "Catálogo web para una floristería. El propietario publica ramos y arreglos; los clientes cotizan por WhatsApp.",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently -n server,client -c green,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace=server --if-present",
    "dev:client": "npm run dev --workspace=client --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:staged": "lint-staged",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present --",
    "test": "npm run test --workspaces --if-present --",
    "test:e2e": "npm run test:e2e --workspace=client --if-present",
    "commit": "git commit",
    "pr": "gh pr create --base dev --fill",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.17.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.18.2"
  }
}
